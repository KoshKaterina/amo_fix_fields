# Сторож Sunscrypt. На сервере: /opt/watchdog/.env (права 600)
# Токены боевых интеграций (amo, МойСклад, Woo, Wazzup, СДЭК, Метрика, Telegram)
# берутся из .env интеграции - здесь их не дублируем.
INTEGRATION_ENV=/opt/integrations/amo_fix_fields/.env
AMO_BASE=https://new5a2e8ea7b16b4.amocrm.ru

# Домены, за продлением которых следим (через запятую)
WATCH_DOMAINS=sunscrypt.ru,tangemshop.ru,keystone-russia.ru,sunscrypt.global

# Ключи, которых нет в .env интеграции. Заполняются при деплое.
YOUGILE_API_KEY=
TIMEWEB_TOKEN=
